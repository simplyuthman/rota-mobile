{
  "name": "rota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rota — mobile shift-scheduling for small teams",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev:api": "pnpm --filter @rota/api dev",
    "tokens": "pnpm --filter @rota/mobile tokens",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "migrate": "node services/api/scripts/migrate.js",
    "migrate:check": "node services/api/scripts/migrate.js --check"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
