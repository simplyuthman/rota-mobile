# ==============================================================================
# Rota — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER put secrets in EXPO_PUBLIC_ variables.
# See docs/SECURITY.md for a full audit of EXPO_PUBLIC_ variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL — Control Plane
# The control plane holds users, sessions, tokens, settings, push devices,
# team_directory, user_team_index, idempotency_keys, billing_quotes,
# payment_webhook_events.
# READ URL may point to the primary if no replica exists.
# ------------------------------------------------------------------------------
DATABASE_CONTROL_URL=
DATABASE_CONTROL_READ_URL=

# ------------------------------------------------------------------------------
# PostgreSQL — Shard 0
# Team-owned data: teams, memberships, invitations, shifts, swaps,
# activity_events, subscriptions, ledger, outbox, notification_jobs,
# product_events.
# ------------------------------------------------------------------------------
DATABASE_SHARD_0_URL=
DATABASE_SHARD_0_READ_URL=

# ------------------------------------------------------------------------------
# PostgreSQL — Shard 1
# Same schema as Shard 0. Teams are routed deterministically by
# crc32(team_id) mod 2 — see docs/decisions/ and SHARDING.md.
# ------------------------------------------------------------------------------
DATABASE_SHARD_1_URL=
DATABASE_SHARD_1_READ_URL=

# ------------------------------------------------------------------------------
# Redis — Cache instance
# Holds: roster, calendar, feed first page, revoked session sids, rate limits.
# Every key MUST have a TTL. Eviction policy: allkeys-lru.
# ------------------------------------------------------------------------------
REDIS_CACHE_URL=

# ------------------------------------------------------------------------------
# Redis — Queue instance
# Holds BullMQ job queues. MUST be noeviction (maxmemory-policy noeviction).
# Never share with the cache instance.
# ------------------------------------------------------------------------------
REDIS_QUEUE_URL=

# ------------------------------------------------------------------------------
# Auth — JWT signing secrets
# JWT_SECRET: signs 15-minute access tokens (HS256, carries sid claim).
# REFRESH_TOKEN_SECRET: signs refresh token payloads before hashing.
# Both must be ≥32 bytes of random data (e.g. openssl rand -base64 32).
# ------------------------------------------------------------------------------
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# ------------------------------------------------------------------------------
# Email — Resend (decision record: docs/decisions/002-email-provider.md)
# Server-only. NEVER in EXPO_PUBLIC_. NEVER in the app bundle.
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ------------------------------------------------------------------------------
# Payments — Flutterwave (test mode only; decision record pending Phase 7)
# Server-only. NEVER in EXPO_PUBLIC_.
# ------------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Sentry — Server DSN
# Server-only. NEVER in EXPO_PUBLIC_. Scrub tokens/secrets/shift notes.
# See docs/SECURITY.md.
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Server runtime
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# HOST restricts which interface the server listens on.
# Use 0.0.0.0 when running inside Docker or on Render.
HOST=127.0.0.1

# CORS — comma-separated list of allowed origins.
# Dev:        http://localhost:3000
# Production: https://rota.pages.dev (Cloudflare Pages invite site)
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Expo — Push Notification Access Token
# Required for sending push notifications via the Expo push gateway.
# Get from: https://expo.dev/accounts/<username>/settings/access-tokens
# Server-only. NEVER in EXPO_PUBLIC_. NEVER in the app bundle.
# ------------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=
