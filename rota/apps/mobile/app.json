{
  "expo": {
    "name": "Rota",
    "slug": "rota-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rota.mobile",
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rota.app",
              "pathPrefix": "/invites"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "organization": "rota",
          "project": "rota-mobile"
        }
      ],
      "expo-font"
    ],
    "scheme": "rota",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}