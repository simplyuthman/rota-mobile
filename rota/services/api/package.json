{
  "name": "@rota/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node scripts/migrate.js",
    "migrate:check": "node scripts/migrate.js --check"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@rota/contracts": "workspace:*",
    "bullmq": "^6.3.16",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.27.0",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "resend": "^6.33.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
